# Ce que le skill ne publie jamais
node_modules/
*.log
.backend/
banc/fige/node_modules/
banc/fige/.backend/
banc/fige/package-lock.json.tmp

# EXCEPTION, et elle est vitale : `.backend/` ci-dessus avalait les fixtures de
# tests/, donc `npm test` passait chez l'auteur et échouait 9 fois sur 66 chez
# quiconque clonait le dépôt. Un verrou qui ne tourne que sur une machine ne
# verrouille rien. Les `.backend/` de tests/fixtures/ sont des fichiers écrits à
# la main, sans donnée de projet réel : ils se publient.
!tests/fixtures/**/.backend/
!tests/fixtures/**/.backend/**

# Les rapports d'audit internes : noms de clients, chemins machine, clones tiers. Jamais publiés.
banc/audit/

# Les archives vivent hors du dépôt (../scan-backend-frontend-archives), jamais dedans
archives/
*-archives/

# Sorties d'un export de base, si un jour l'une d'elles tombait ici par erreur
# (banc/mesure/journal/mesures.jsonl est le journal de mesure : il reste)
*.zip
export-base*

# Bancs d'essai internes : résultats sur nos projets, noms de clients, chemins machine
banc/affirmations/
banc/stacks/
banc/mesure/sources.json

# Copie de travail de la boucle de réparation (dépôt git imbriqué)
banc/reparation-essai/
